    "verify:mlb-k-v5": "tsx src/server/mlbPitcherKV5.verify.ts",
    "verify:game-markets": "tsx src/server/gameMarketModel.verify.ts",
    "verify:parlay": "tsx src/server/parlay.verify.ts",
    "verify:game-calibration": "tsx src/server/gameMarketCalibration.verify.ts",
    "verify:bankroll": "tsx src/server/bankroll.verify.ts",
    "verify:cross-sport-tennis": "tsx src/server/decisionBoardCrossSportTennisVerification.ts",
    "verify:coverage-1-14-5": "tsx src/server/decisionBoardCoverage145Verification.ts",
    "verify:tennis-1-14-6": "tsx src/server/tennisMarketModelCoverage146Verification.ts",
